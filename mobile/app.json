{
  "expo": {
    "name": "BrickBuilder",
    "slug": "brickbuilder",
    "version": "1.0.5",
    "orientation": "default",
    "scheme": "brickbuilder",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "ai.brickbuilder.app",
      "buildNumber": "20",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BrickBuilder uses the camera only when you choose to photograph a model for a new generation.",
        "NSPhotoLibraryUsageDescription": "BrickBuilder lets you choose a reference image for a new brick-model generation.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "ai.brickbuilder.app",
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "eas": {
        "projectId": "92d07dc7-90af-4583-8894-0a2df516b467"
      }
    },
    "owner": "jjohnson5253",
    "plugins": [
      "expo-iap"
    ]
  }
}
