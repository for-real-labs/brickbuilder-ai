SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DEVELOPER_API_KEY=
FAL_KEY=
POSTHOG_API_KEY=
POSTHOG_HOST=
API_MODE=
BRICKOWL_API_KEY=
RESEND_API_KEY=
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_LIVE=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
ANONYMOUS_CALL_LIMIT=100000
ANONYMOUS_WINDOW_CALL_LIMIT=100000
ANONYMOUS_WINDOW_SECONDS=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required if ANTHROPIC_API_KEY is scoped to a workspace (not an org-wide key):
# find it in the Anthropic Console under Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Optional /llmRender tuning
# OPENAI_LLM_RENDER_MODEL (or the request's "model" field) picks which model
# handles /llmRender. Use any OpenAI model name to call OpenAI, or a
# "claude-..." name (e.g. claude-fable-5) to call Anthropic instead -
# ANTHROPIC_API_KEY must be set for the latter.
OPENAI_LLM_RENDER_MODEL=gpt-5.6-sol
OPENAI_LLM_RENDER_REASONING_EFFORT=medium
OPENAI_LLM_RENDER_TIMEOUT_SECONDS=240
ANTHROPIC_LLM_RENDER_MAX_TOKENS=8192
ANTHROPIC_LLM_RENDER_TIMEOUT_SECONDS=240

# Optional /llmToBricks ("LLM Render") tuning. Requests pick a model from the
# allow-list in src/requests/llmToBricks.py; claude-* models need
# ANTHROPIC_API_KEY and gpt-* models need OPENAI_API_KEY.
LLM_TO_BRICKS_MODEL=claude-opus-5-5
LLM_TO_BRICKS_MAX_TOKENS=65536
LLM_TO_BRICKS_TIMEOUT_SECONDS=600
LLM_TO_BRICKS_OPENAI_REASONING_EFFORT=medium
LLM_TO_BRICKS_MODE=design

# Optional Nova full-set agent. npm run setup:nova installs these defaults.
# The local launcher discovers the runtime and enables local provider setup.
# NOVA_TOOLKIT_ROOT=/absolute/path/to/ldraw-nova
# NOVA_PYTHON=/absolute/path/to/ldraw-nova/.venv/bin/python
# NOVA_TIMEOUT_SECONDS=1800
# LDRAW_DIR=/absolute/path/to/ldraw
TYPESAFE_API_KEY=
# Set false to explicitly disable local sign-in; leave unset to use local_run.
# BRICKBUILDER_LOCAL_PROVIDERS=false
