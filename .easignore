# Native builds use mobile/. Keep local Python environments and web/server
# projects out of the EAS archive; the app loads the deployed website.
.git/
node_modules/
**/node_modules/
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[oc]
**/*.py[oc]
backend/
frontend/
serverless/
supabase/
docs/
plugins/
scripts/
tests/
.github/
.agents/
mobile/.expo/
mobile/dist/
mobile/ios/
mobile/android/
mobile/app-store/
mobile/google-play/
.env
.env.*
**/.env
**/.env.*
*.jks
**/*.jks
*.keystore
**/*.keystore
*.p8
**/*.p8
*.p12
**/*.p12
*.mobileprovision
**/*.mobileprovision
